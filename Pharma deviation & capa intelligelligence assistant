        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from datetime import datetime, timedelta\n",
        "\n",
        "np.random.seed(42)"
      ],
      "metadata": {
        "id": "d8-ndVJ9Zfji"
      },
      "execution_count": 19,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "n = 1200\n",
        "\n",
        "departments = [\"Manufacturing\", \"Quality Control\", \"Quality Assurance\",\n",
        "               \"Engineering\", \"Warehouse\"]\n",
        "\n",
        "process_stages = [\"Formulation\", \"Filtration\", \"Filling\",\n",
        "                  \"Packaging\", \"Storage\", \"Testing\"]\n",
        "\n",
        "categories = [\"Equipment Failure\", \"Process Deviation\",\n",
        "              \"Documentation Error\", \"Environmental Excursion\",\n",
        "              \"Material Issue\", \"Human Error\"]\n",
        "\n",
        "equipment_types = [\"Bioreactor\", \"Filling Machine\",\n",
        "                   \"Filtration Unit\", \"HPLC\", \"Cold Storage\",\n",
        "                   \"Mixing Vessel\"]\n",
        "\n",
        "severity_values = [\"Minor\", \"Major\", \"Critical\"]\n",
        "\n",
        "df = pd.DataFrame({\n",
        "    \"Deviation_ID\": [f\"DEV-{i:05d}\" for i in range(1, n + 1)],\n",
        "    \"Event_Date\": pd.to_datetime(\"2024-01-01\") +\n",
        "                  pd.to_timedelta(np.random.randint(0, 900, n), unit=\"D\"),\n",
        "    \"Department\": np.random.choice(departments, n),\n",
        "    \"Process_Stage\": np.random.choice(process_stages, n),\n",
        "    \"Category\": np.random.choice(categories, n),\n",
        "    \"Equipment\": np.random.choice(equipment_types, n),\n",
        "    \"Severity\": np.random.choice(\n",
        "        severity_values, n, p=[0.55, 0.35, 0.10]\n",
        "    ),\n",
        "    \"Batch_Impact\": np.random.choice(\n",
        "        [\"Yes\", \"No\"], n, p=[0.35, 0.65]\n",
        "    ),\n",
        "    \"Product_Impact\": np.random.choice(\n",
        "        [\"Yes\", \"No\"], n, p=[0.20, 0.80]\n",
        "    ),\n",
        "    \"Repeat_Count_90d\": np.random.poisson(1.2, n),\n",
        "    \"Duration_Hours\": np.random.gamma(2.0, 5.0, n),\n",
        "    \"Environmental_Excursion\": np.random.choice(\n",
        "        [\"Yes\", \"No\"], n, p=[0.15, 0.85]\n",
        "    ),\n",
        "    \"Training_Current\": np.random.choice(\n",
        "        [\"Yes\", \"No\"], n, p=[0.90, 0.10]\n",
        "    )\n",
        "})\n",
        "\n",
        "# Create an artificial risk score for teaching purposes\n",
        "severity_score = df[\"Severity\"].map({\n",
        "    \"Minor\": 1,\n",
        "    \"Major\": 2,\n",
        "    \"Critical\": 3\n",
        "})\n",
        "\n",
        "risk_score = (\n",
        "    1.5 * severity_score\n",
        "    + 1.5 * (df[\"Batch_Impact\"] == \"Yes\").astype(int)\n",
        "    + 2.0 * (df[\"Product_Impact\"] == \"Yes\").astype(int)\n",
        "    + 0.8 * df[\"Repeat_Count_90d\"]\n",
        "    + 1.5 * (df[\"Environmental_Excursion\"] == \"Yes\").astype(int)\n",
        "    + 1.0 * (df[\"Training_Current\"] == \"No\").astype(int)\n",
        ")\n",
        "\n",
        "# Add randomness so that labels are not perfectly deterministic\n",
        "risk_score = risk_score + np.random.normal(0, 1.5, n)\n",
        "\n",
        "df[\"Investigation_Priority\"] = np.select(\n",
        "    [risk_score >= 8.5, risk_score >= 5.0],\n",
        "    [\"High\", \"Medium\"],\n",
        "    default=\"Low\"\n",
        ")\n",
        "\n",
        "df[\"CAPA_Required\"] = np.where(\n",
        "    (df[\"Investigation_Priority\"] == \"High\") |\n",
        "    (df[\"Repeat_Count_90d\"] >= 3),\n",
        "    \"Yes\",\n",
        "    \"No\"\n",
        ")\n",
        "\n",
        "df[\"Closure_Days\"] = np.maximum(\n",
        "    1,\n",
        "    np.round(\n",
        "        3 + risk_score * 1.5 + np.random.normal(0, 3, n)\n",
        "    )\n",
        ").astype(int)\n",
        "\n",
        "descriptions = {\n",
        "    \"Equipment Failure\": \"Unexpected equipment performance was observed during operation.\",\n",
        "    \"Process Deviation\": \"A process parameter deviated from the expected operating condition.\",\n",
        "    \"Documentation Error\": \"An error was identified in the manufacturing documentation.\",\n",
        "    \"Environmental Excursion\": \"An environmental monitoring excursion was recorded.\",\n",
        "    \"Material Issue\": \"A material-related discrepancy was identified.\",\n",
        "    \"Human Error\": \"An operational error was identified during the activity.\"\n",
        "}\n",
        "\n",
        "df[\"Description\"] = df[\"Category\"].map(descriptions)\n",
        "\n",
        "df.to_csv(\"deviation_records.csv\", index=False)\n",
        "\n",
        "print(\"Dataset generated successfully\")\n",
        "print(\"Dataset shape:\", df.shape)\n",
        "print(df.head())\n"
      ],
